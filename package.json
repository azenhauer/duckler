{
  "name": "visual-library-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @visual-library/web",
    "build": "npm run build --workspaces --if-present",
    "build:extension": "npm run build --workspace @visual-library/extension",
    "build:extension:dev": "npm run build:dev --workspace @visual-library/extension",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:security": "vitest run packages/backend/src",
    "pages:preview": "npx wrangler pages dev apps/web/dist",
    "pages:deploy": "npx wrangler pages deploy apps/web/dist --project-name=duckler",
    "typecheck": "tsc -b && npm run typecheck --workspace @visual-library/extension && tsc -p functions/tsconfig.json --noEmit",
    "test:integration": "vitest run apps/extension apps/web/src/lib/extension*",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:canvas:ui": "node scripts/canvas-smoke.mjs",
    "test:canvas:tools": "node scripts/canvas-tools-smoke.mjs",
    "test:canvas:capacity": "node scripts/canvas-capacity-smoke.mjs",
    "test:notes:ui": "node scripts/notes-editor-smoke.mjs",
    "test:membership:ui": "node scripts/membership-smoke.mjs",
    "test:extension:browser": "node scripts/extension-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^20.14.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.7",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
